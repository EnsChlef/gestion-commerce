# Copy this file to .env on the SERVER only. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Generate the values below with: node scripts/generate-admin-credentials.mjs
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_SALT="PASTE_GENERATED_SALT"
ADMIN_PASSWORD_HASH="PASTE_GENERATED_HASH"
SESSION_SECRET="PASTE_GENERATED_RANDOM_SECRET"

# Keep "lax" when the client and API are served on the same site.
# Use "none" only with HTTPS when the client and API are on different sites.
AUTH_COOKIE_SAME_SITE="lax"
